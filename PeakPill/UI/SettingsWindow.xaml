<Window x:Class="PeakPill.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PeakPill.UI"
        Title="PeakPill" Width="800" Height="660" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#FF1E1E1E" Foreground="White"
        FontFamily="{StaticResource TextFont}" FontSize="13" UseLayoutRounding="True">
    <!-- Settings redesign (approved mockup 2026-11-14): island preview to click through, a small picture next to every
         option, choices as picture tiles, a page with all animations, connections folded until you set them up -->
    <Window.Resources>
        <!-- segmented control (An / Reduziert / Aus, Selbstauslöser) -->
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFC7C7CC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="5" Padding="11,3" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF636366" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegBox" TargetType="Border">
            <Setter Property="Background" Value="#FF1C1C1E" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- page chips under the preview -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFE5E5EA" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="GroupName" Value="PreviewView" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="11" Padding="10,3.5" Background="#FF3A3A3C">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF48484A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="Black" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- coloured app square in front of a connection -->
        <Style x:Key="AppTile" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- "Einrichten" / "Details": folds a connection open (pressed = open) -->
        <Style x:Key="MacButtonToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="11,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="bg" Background="#FF5A5A5E" CornerRadius="6" BorderBrush="#33FFFFFF" BorderThickness="0,0.6,0,0" />
                            <Border x:Name="hov" Background="White" Opacity="0" CornerRadius="6" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hov" Property="Opacity" Value="0.06" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FF3A3A3C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,14" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="#FF1E1E1E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========== Sidebar ========== -->
        <Border x:Name="Sidebar" Background="#FF2B2B2D" BorderBrush="#FF000000" BorderThickness="0,0,0.5,0" Padding="10,14,10,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,14">
                    <Border Width="34" Height="34" CornerRadius="8" Background="Black">
                        <Border Width="22" Height="8" CornerRadius="4" Background="#FF2C2C2E" VerticalAlignment="Top" Margin="0,6,0,0" />
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PeakPill" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock x:Name="VersionText" Foreground="{StaticResource SubText}" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <!-- search over every setting (user wish 2026-11-17): typing replaces the page list with matches -->
                <Border DockPanel.Dock="Top" Margin="2,0,2,10" Background="#FF1E1E1E" CornerRadius="7" BorderThickness="1" BorderBrush="#1FFFFFFF" Padding="8,0,2,0" Height="28">
                    <DockPanel>
                        <ui:SfIcon DockPanel.Dock="Left" Kind="search" Size="12" Foreground="{StaticResource SubText}" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False" />
                        <Button x:Name="SettingsSearchClear" DockPanel.Dock="Right" Style="{StaticResource BareIconButton}" ui:Ext.Icon="xmark" ui:Ext.IconSize="10" Width="20" Height="20"
                                VerticalAlignment="Center" Foreground="{StaticResource SubText}" Visibility="Collapsed" Click="SettingsSearchClear_Click" ToolTip="Suche leeren" />
                        <TextBox x:Name="SettingsSearch" Style="{StaticResource BareBox}" Tag="Suchen" FontSize="12.5" VerticalAlignment="Center"
                                 TextChanged="SettingsSearch_TextChanged" PreviewKeyDown="SettingsSearch_PreviewKeyDown" />
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="SearchResultsScroll" DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="SearchResults" />
                </ScrollViewer>
                <StackPanel x:Name="Nav">
                    <RadioButton Style="{StaticResource NavButton}" Tag="General" ui:Ext.Icon="gear" Background="#FF8E8E93" Content="Allgemein" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="Look" ui:Ext.Icon="paintbrush" Background="#FF0A84FF" Content="Erscheinungsbild" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="Anim" ui:Ext.Icon="sparkles" Background="#FFFF375F" Content="Animationen" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="Keys" ui:Ext.Icon="keyboard" Background="#FF8E8E93" Content="Tastatur" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="Clip" ui:Ext.Icon="clipboard" Background="#FFFF9F0A" Content="Zwischenablage" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="Shot" ui:Ext.Icon="camera" Background="#FFBF5AF2" Content="Bildschirmfoto" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="Widgets" ui:Ext.Icon="widgets" Background="#FF30D158" Content="Widgets" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="Ai" ui:Ext.Icon="bubble" Background="#FF5E5CE6" Content="KI" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="About" ui:Ext.Icon="info" Background="#FF8E8E93" Content="Info" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Padding="22,16,22,20">
            <Grid>
                <!-- ======== GENERAL ======== -->
                <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                    <TextBlock Text="Allgemein" Style="{StaticResource PageTitle}" />
                    <!-- language (2026-11-17): English by default; switching restarts the island -->
                    <Border Style="{StaticResource SettingCard}">
                        <Border Style="{StaticResource LastRow}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource SegBox}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="LangEnglish" Style="{StaticResource Seg}" GroupName="Lang" Content="English" Checked="Lang_Checked" />
                                        <RadioButton x:Name="LangGerman" Style="{StaticResource Seg}" GroupName="Lang" Content="Deutsch" Checked="Lang_Checked" />
                                    </StackPanel>
                                </Border>
                                <ui:HintPic Kind="lang" />
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Sprache · Language" />
                                    <TextBlock x:Name="LangNote" Style="{StaticResource Desc}" Text="PeakPill startet dafür kurz neu." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Border>
                    <TextBlock Text="Insel öffnen" Style="{StaticResource GroupHeader}" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <ToggleButton x:Name="OptHover" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Opt_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="hover" />
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Beim Darüberfahren öffnen" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Aus: nur per Klick oder Tastenkürzel." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <TextBlock x:Name="HoverDelayText" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" Width="54" TextAlignment="Right" VerticalAlignment="Center" />
                                    <Slider x:Name="OptHoverDelay" DockPanel.Dock="Right" Style="{StaticResource ThinSlider}" Foreground="{DynamicResource Accent}" Width="140"
                                            Minimum="0" Maximum="800" VerticalAlignment="Center" ValueChanged="HoverDelay_Changed" />
                                    <ui:HintPic Kind="delay" />
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Verzögerung" />
                                        <TextBlock Style="{StaticResource Desc}" Text="So lange muss der Zeiger auf der Insel bleiben." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <ToggleButton x:Name="OptSmartTab" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Opt_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="smart" />
                                    <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="Passende Seite öffnen" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Beim Öffnen siehst du, was gerade passiert ist, z. B. nach einem neuen Song die Musik." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource LastRow}">
                                <DockPanel>
                                    <ToggleButton x:Name="OptTrackPeek" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Opt_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="trackpeek" />
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Neuen Titel kurz anzeigen" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Bei einem neuen Song zeigt die Insel kurz Titel und Cover." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="In der Insel zeigen" Style="{StaticResource GroupHeader}" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <!-- the clock (user's pick 2026-11-18, mockup B): in the middle of the quiet island -->
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <ToggleButton x:Name="OptClock" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Opt_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="autostart" />
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Uhrzeit" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Läuft sonst nichts, steht die Uhrzeit mittig in der Insel." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <!-- side things (2026-11-18): ring stack inside the island (default) or the old circles beside it -->
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <ToggleButton x:Name="OptSideBubbles" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Opt_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="trackpeek" />
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Kreise neben der Insel" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Aus: Timer, Claude und Anruf stehen als kleiner Ring-Stapel rechts in der Insel." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border x:Name="ClockSecondsRow" Style="{StaticResource Row}">
                                <DockPanel>
                                    <ToggleButton x:Name="OptSeconds" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Opt_Click" VerticalAlignment="Center" />
                                    <StackPanel Margin="54,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Mit Sekunden" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Die Ziffern rollen jede Sekunde weiter." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <ToggleButton x:Name="OptLevel" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Opt_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="level" />
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Lautstärke und Helligkeit" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Beim Ändern wird die Insel zu einem Balken mit Prozent. Helligkeit nur bei Laptops." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <ToggleButton x:Name="OptDevice" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Opt_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="headphones" />
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Kopfhörer verbunden" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Zeigt ihren Namen, bei Bluetooth mit Akkustand." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <ToggleButton x:Name="OptReplySend" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Opt_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="reply" />
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Antwort gleich senden" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Eine Antwort aus der Insel wird eingefügt und gleich abgeschickt. Aus: Enter drückst du selbst." />
                                        <TextBlock Style="{StaticResource Desc}" Tag="Guide" Text="Die Insel findet den Chat über die Suche der App. Bei gleichen Namen kann sie einen anderen Chat treffen – deshalb ist Aus sicherer." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource LastRow}">
                                <DockPanel>
                                    <ToggleButton x:Name="OptPower" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Opt_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="charge" />
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Laden und Akku schwach" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Netzteil an oder ab, Akku bei 20 % und 10 %. Nur bei Laptops." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Vollbild" Style="{StaticResource GroupHeader}" />
                    <Border Style="{StaticResource SettingCard}">
                        <Border Style="{StaticResource LastRow}" Padding="12,10,12,12">
                            <StackPanel>
                                <TextBlock Text="Bei Spielen und Videos" />
                                <TextBlock Style="{StaticResource Desc}" Text="Was die Insel macht, solange ein Spiel oder Video den ganzen Bildschirm füllt." Margin="0,2,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="FsBar" Style="{StaticResource OptionRadio}" GroupName="Fs" Tag="Leiste mit PC-Werten" Checked="Fullscreen_Checked"><ui:HintPic Kind="fs.bar" /></RadioButton>
                                    <RadioButton x:Name="FsHide" Style="{StaticResource OptionRadio}" GroupName="Fs" Tag="Insel ausblenden" Checked="Fullscreen_Checked"><ui:HintPic Kind="fs.hide" /></RadioButton>
                                    <RadioButton x:Name="FsNormal" Style="{StaticResource OptionRadio}" GroupName="Fs" Tag="Normal anzeigen" Checked="Fullscreen_Checked"><ui:HintPic Kind="fs.norm" /></RadioButton>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                    <TextBlock Text="System" Style="{StaticResource GroupHeader}" />
                    <Border Style="{StaticResource SettingCard}">
                        <Border Style="{StaticResource LastRow}">
                            <DockPanel>
                                <ToggleButton x:Name="OptAutostart" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Opt_Click" VerticalAlignment="Center" />
                                <ui:HintPic Kind="autostart" />
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Autostart" />
                                    <TextBlock x:Name="AutostartDesc" Style="{StaticResource Desc}" Text="PeakPill startet, wenn du dich bei Windows anmeldest." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Border>

                    <TextBlock Text="Timer" Style="{StaticResource GroupHeader}" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <Button x:Name="SoundPreviewBtn" DockPanel.Dock="Right" Style="{StaticResource MacButton}" Margin="8,0,0,0" Padding="10,3" VerticalAlignment="Center"
                                            Click="SoundPreview_Click" ToolTip="Anhören">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SfIcon x:Name="SoundPreviewIcon" Kind="play.fill" Size="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SoundPreviewText" Text="Anhören" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <ComboBox x:Name="OptTimerSound" DockPanel.Dock="Right" Style="{StaticResource DarkCombo}" Width="170" VerticalAlignment="Center" SelectionChanged="TimerSound_Changed" />
                                    <ui:HintPic Kind="sound" />
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Ton bei Ablauf" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Eigene Töne, Windows-Alarme oder eine Datei." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource LastRow}">
                                <DockPanel>
                                    <ToggleButton x:Name="OptTimerRepeat" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Opt_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="repeat" />
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Wiederholen, bis ich bestätige" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Der Ton läuft weiter, bis du „OK“ klickst (höchstens 1 Minute)." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- connections: folded – the steps only show when you set one up -->
                    <TextBlock Text="Verbindungen" Style="{StaticResource GroupHeader}" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <!-- LocalSend: on/off and the name the others see (was missing before 2026-11-17) -->
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <ToggleButton x:Name="OptLocalSend" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="LocalSend_Changed" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBox x:Name="OptLocalSendName" DockPanel.Dock="Right" Style="{StaticResource MacTextBox}" Width="140" VerticalAlignment="Center" LostFocus="LocalSend_Changed" />
                                    <Border Style="{StaticResource AppTile}" Background="#FF0A84FF"><ui:SfIcon Kind="share" Size="16" Foreground="White" /></Border>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="LocalSend" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Unter diesem Namen sehen dich Handy und PCs in der Nähe." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <!-- Discord -->
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <ToggleButton x:Name="DiscordExpand" DockPanel.Dock="Right" Style="{StaticResource MacButtonToggle}" Content="Einrichten" Tag="DiscordDetails" Click="Expand_Click" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock x:Name="DiscordStatus" DockPanel.Dock="Right" Style="{StaticResource Desc}" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <Border Style="{StaticResource AppTile}" Background="#FF5865F2"><ui:SfIcon Kind="mic" Size="16" Foreground="White" /></Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Discord" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Stumm schalten, wer im Anruf ist, Stream." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <StackPanel x:Name="DiscordDetails" Visibility="Collapsed" Background="#0AFFFFFF">
                                <Border Style="{StaticResource Row}" Padding="54,9,12,9">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Desc}" Margin="0"
                                                   Text="Mit einer eigenen Discord-App schaltet dich die Insel direkt in Discord stumm." />
                                        <TextBlock Style="{StaticResource Desc}" Tag="Guide"
                                                   Text="discord.com/developers → New Application → unter OAuth2 die Redirect-URL http://127.0.0.1 eintragen → Client-ID und Client-Secret unten einfügen → Verbinden." />
                                        <TextBlock Margin="0,4,0,0"><Hyperlink NavigateUri="https://discord.com/developers/applications" RequestNavigate="Link_RequestNavigate">Discord Developer Portal öffnen</Hyperlink></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Row}" Padding="54,9,12,9">
                                    <DockPanel>
                                        <TextBlock Text="Client-ID" Width="90" VerticalAlignment="Center" />
                                        <TextBox x:Name="OptDiscordId" Style="{StaticResource MacTextBox}" Tag="z. B. 1300000000000000000" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Row}" Padding="54,9,12,9">
                                    <DockPanel>
                                        <TextBlock Text="Client-Secret" Width="90" VerticalAlignment="Center" />
                                        <PasswordBox x:Name="OptDiscordSecret" Height="26" Background="#FF2C2C2E" Foreground="White" BorderBrush="#26FFFFFF" CaretBrush="White"
                                                     VerticalContentAlignment="Center" Padding="6,0" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Row}" Padding="54,9,12,9">
                                    <DockPanel>
                                        <ToggleButton x:Name="OptMicBlue" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="MicBlue_Click" VerticalAlignment="Center" />
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Mikro-Symbol in Blau" />
                                            <TextBlock Style="{StaticResource Desc}" Text="Aus = weiß. Stumm in Discord ist immer rot und durchgestrichen." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Row}" Padding="54,9,12,9">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBox x:Name="OptDiscordStreamKey" DockPanel.Dock="Right" Style="{StaticResource KeyBox}" Width="170" Tag="Klicken und drücken"
                                                     PreviewKeyDown="DiscordStreamKey_PreviewKeyDown" />
                                            <TextBlock Text="Stream starten / beenden" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Desc}" Margin="0,4,0,0"
                                                   Text="Nur als Ersatz nötig, falls die Insel den Stream nicht selbst starten kann." />
                                        <TextBlock Style="{StaticResource Desc}" Tag="Guide"
