                                        <ComboBoxItem Content="1000" />
                                    </ComboBox>
                                    <ui:HintPic Kind="limit" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Einträge im Verlauf" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Angeheftetes bleibt immer erhalten." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource LastRow}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MacButton}" Content="Verlauf leeren…" Click="ClearHistory_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="clear" />
                                    <TextBlock Text="Alles außer Angeheftetem löschen" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Desc}" Margin="2,0,0,0"
                               Text="Nutzt die normale Windows-Zwischenablage. Passwort-Manager, die das Aufzeichnen verbieten, werden respektiert. Alles bleibt lokal auf diesem PC." />
                </StackPanel>

                <!-- ======== SCREENSHOT ======== -->
                <StackPanel x:Name="PageShot" Visibility="Collapsed">
                    <TextBlock Text="Bildschirmfoto" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MacButton}" Content="Auswählen…" Margin="8,0,0,0" Click="BrowseShotFolder_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="folder" />
                                    <TextBlock Text="Sichern in" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBox x:Name="OptShotFolder" Style="{StaticResource MacTextBox}" FontSize="12" LostFocus="ShotFolder_LostFocus" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <ToggleButton x:Name="OptShotAsk" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Opt_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="shotpreview" />
                                    <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="Vorschau in der Insel" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Die Insel geht nach unten auf und zeigt das Foto: Sichern, Text erkennen oder Verwerfen." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource LastRow}">
                                <DockPanel>
                                    <ToggleButton x:Name="OptShotAuto" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Opt_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="autosave" />
                                    <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="Immer automatisch sichern" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Aus: du entscheidest nach dem Foto." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Desc}" Margin="2,0,0,0"
                               Text="Bereich aufziehen wie beim Snipping Tool. Das Foto landet sofort in der Zwischenablage. Die Texterkennung läuft offline mit Windows." />
                </StackPanel>

                <!-- ======== KI (2026-11-17): who answers in the island's KI tab, the user's own key, the model ======== -->
                <StackPanel x:Name="PageAi" Visibility="Collapsed">
                    <TextBlock Text="KI" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource SegBox}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="AiClaude" Style="{StaticResource Seg}" GroupName="AiProv" Content="Claude" Checked="AiProvider_Checked" />
                                            <RadioButton x:Name="AiChatGpt" Style="{StaticResource Seg}" GroupName="AiProv" Content="ChatGPT" Checked="AiProvider_Checked" />
                                            <RadioButton x:Name="AiGemini" Style="{StaticResource Seg}" GroupName="AiProv" Content="Gemini" Checked="AiProvider_Checked" />
                                        </StackPanel>
                                    </Border>
                                    <ui:HintPic Kind="aichat" />
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Wer antwortet" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Mit diesem Dienst schreibst du im KI-Tab der Insel." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button x:Name="AiCheckBtn" DockPanel.Dock="Right" Style="{StaticResource MacButton}" Content="Prüfen" Margin="8,0,0,0" Click="AiCheck_Click" VerticalAlignment="Center" />
                                        <ui:HintPic Kind="aikey" />
                                        <StackPanel Width="118" VerticalAlignment="Center">
                                            <TextBlock Text="API-Schlüssel" />
                                            <TextBlock x:Name="AiKeyHint" Style="{StaticResource Desc}" />
                                        </StackPanel>
                                        <PasswordBox x:Name="OptAiKey" Height="26" Background="#FF2C2C2E" Foreground="White" BorderBrush="#26FFFFFF" CaretBrush="White"
                                                     VerticalContentAlignment="Center" Padding="6,0" VerticalAlignment="Center" LostFocus="AiKey_LostFocus" />
                                    </DockPanel>
                                    <DockPanel Margin="76,6,0,0">
                                        <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0"><Hyperlink x:Name="AiKeyLink" NavigateUri="https://console.anthropic.com/settings/keys" RequestNavigate="Link_RequestNavigate">Schlüssel holen</Hyperlink></TextBlock>
                                        <TextBlock x:Name="AiKeyStatus" Style="{StaticResource Desc}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource LastRow}">
                                <DockPanel>
                                    <ComboBox x:Name="OptAiModel" DockPanel.Dock="Right" Style="{StaticResource DarkCombo}" Width="210" VerticalAlignment="Center" SelectionChanged="AiModel_Changed" />
                                    <ui:HintPic Kind="aimodel" />
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Modell" />
                                        <TextBlock Style="{StaticResource Desc}" Text="„Prüfen“ lädt alle Modelle, die dein Schlüssel nutzen darf." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Desc}" Margin="2,0,0,0" TextWrapping="Wrap"
                               Text="Der Schlüssel liegt verschlüsselt auf diesem PC. Fragen gehen direkt an den Dienst und kosten dort Guthaben. Unter Tastatur gibt es ein Kürzel für den KI-Chat." />
                </StackPanel>

                <!-- ======== WIDGETS ======== -->
                <StackPanel x:Name="PageWidgets" Visibility="Collapsed">
                    <TextBlock Text="Widgets" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Auf dem Schreibtisch" Style="{StaticResource GroupHeader}" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel x:Name="DesktopWidgetsPanel" />
                    </Border>
                    <Border Style="{StaticResource SettingCard}" Margin="0,10,0,0">
                        <Border Style="{StaticResource LastRow}">
                            <DockPanel>
                                <Button x:Name="ArrangeBtn" DockPanel.Dock="Right" Style="{StaticResource MacAccentButton}" Content="Anordnen" Click="ArrangeWidgets_Click" VerticalAlignment="Center" />
                                <ui:HintPic Kind="widgets" />
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Widgets anordnen" />
                                    <TextBlock Style="{StaticResource Desc}" Text="Sonst sind sie fest. Beim Anordnen ziehen und loslassen – sie rasten im Raster ein. Fertig über die Insel oder Rechtsklick auf ein Widget." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Border>
                    <TextBlock Text="Wetter" Style="{StaticResource GroupHeader}" />
                    <Border Style="{StaticResource SettingCard}">
                        <Border Style="{StaticResource LastRow}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MacAccentButton}" Content="Übernehmen" Margin="8,0,0,0" Click="SetCity_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="sun" />
                                    <TextBlock Text="Ort" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBox x:Name="OptCity" Style="{StaticResource MacTextBox}" Tag="Berlin" KeyDown="City_KeyDown" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock x:Name="CityStatus" Style="{StaticResource Desc}" Margin="76,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <TextBlock Text="Weltzeituhr" Style="{StaticResource GroupHeader}" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel x:Name="WorldPanel" />
                    </Border>
                    <TextBlock Style="{StaticResource Desc}" Margin="2,0,0,0" Text="Eingeschaltete Widgets liegen auf dem Schreibtisch hinter deinen Fenstern. Zum Verschieben einfach ziehen." />
                </StackPanel>

                <!-- ======== ABOUT ======== -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Text="Info" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <ui:HintPic Kind="privacy" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Datenschutz" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Zwischenablage, Dateien, Fotos und Erinnerungen bleiben auf diesem PC. Ins Netz geht nur, was du selbst einrichtest: Wetter, Preisalarme, Spotify und Discord – und die Frage an GitHub, ob es eine neue Version gibt." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <ToggleButton x:Name="OptUpdateCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Opt_Click" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MacButton}" Content="Jetzt prüfen" Margin="0,0,10,0" Click="CheckUpdate_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="update" />
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Nach Updates suchen" />
                                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Desc}" Text="Beim Start fragt PeakPill GitHub nach einer neuen Version und bietet sie zum Installieren an." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MacButton}" Content="Im Explorer zeigen" Click="OpenDataDir_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="data" />
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Datenordner" />
                                        <TextBlock x:Name="DataDirText" Style="{StaticResource Desc}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <!-- settings to a file and back (2026-11-17) – e.g. for a second PC -->
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource MacButton}" Content="Laden…" Click="ImportSettings_Click" />
                                        <Button Style="{StaticResource MacButton}" Content="Sichern…" Margin="8,0,0,0" Click="ExportSettings_Click" />
                                    </StackPanel>
                                    <ui:HintPic Kind="data" />
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Einstellungen sichern" />
                                        <TextBlock x:Name="BackupStatus" Style="{StaticResource Desc}" Text="Als Datei, z. B. für einen zweiten PC. Schlüssel und Passwörter bleiben hier." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource LastRow}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MacButton}" Content="Beenden" Click="Quit_Click" VerticalAlignment="Center" />
                                    <ui:HintPic Kind="power" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="PeakPill beenden" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Die Insel verschwindet, bis du PeakPill wieder startest." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
