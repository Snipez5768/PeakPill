                                                    <Ellipse Width="4" Height="4" Fill="#FF48484A" />
                                                    <Rectangle Width="1" Height="7" Fill="#FF3A3A3C" Margin="6,0,6,0" />
                                                    <Ellipse Width="4" Height="4" Fill="#FF48484A" Margin="0,0,3,0" />
                                                    <Ellipse Width="4" Height="4" Fill="#FF48484A" />
